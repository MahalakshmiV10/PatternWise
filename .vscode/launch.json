{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "PatternWise: main app",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "PatternWise: run all checks",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run_all.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "PatternWise: quiz",
            "type": "debugpy",
            "request": "launch",
            "module": "quiz.quiz",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        }
    ]
}
