classDiagram
    class Amplifier {
        +turn_on() str
        +set_volume(level) str
        +turn_off() str
    }
    class Projector {
        +turn_on() str
        +turn_off() str
    }
    class StreamingPlayer {
        +play(title) str
        +stop() str
    }
